    <string name="tool_password_generator">Generador de contraseñas</string>
    <string name="tool_password_generator_desc">Genera contraseñas o PIN aleatorios y seguros, eligiendo la longitud y los caracteres usados, con indicador de seguridad.</string>
    <string name="tool_token_generator">Generador de tokens</string>
    <string name="tool_token_generator_desc">Genera cadenas aleatorias con los caracteres que quieras: mayúsculas, minúsculas, números y/o símbolos.</string>
    <string name="tool_hash_text">Hash de texto</string>
    <string name="tool_hash_text_desc">Calcula el hash de un texto con MD5, SHA1, SHA256, SHA224, SHA512, SHA384, SHA3 o RIPEMD160.</string>
    <string name="tool_bcrypt">Bcrypt</string>
    <string name="tool_bcrypt_desc">Genera y compara hashes bcrypt, función de hash de contraseñas basada en Blowfish.</string>
    <string name="tool_uuid_generator">Generador de UUID</string>
    <string name="tool_uuid_generator_desc">Un UUID es un número de 128 bits que identifica información de forma única.</string>
    <string name="tool_ulid_generator">Generador de ULID</string>
    <string name="tool_ulid_generator_desc">Genera identificadores únicos ordenables lexicográficamente (ULID).</string>
    <string name="tool_encryption">Cifrar / descifrar texto</string>
    <string name="tool_encryption_desc">Cifra y descifra texto con algoritmos como AES, TripleDES, Rabbit o RC4.</string>
    <string name="tool_bip39_generator">Generador BIP39</string>
    <string name="tool_bip39_generator_desc">Genera una frase BIP39 a partir de entropía aleatoria o existente, o recupera la entropía de la frase.</string>
    <string name="tool_hmac_generator">Generador HMAC</string>
    <string name="tool_hmac_generator_desc">Calcula un código de autenticación de mensajes (HMAC) con una clave secreta y la función hash que prefieras.</string>
    <string name="tool_rsa_key_pair_generator">Generador de claves RSA</string>
    <string name="tool_rsa_key_pair_generator_desc">Genera un nuevo par de claves RSA pública y privada en formato PEM.</string>
    <string name="tool_password_strength_analyser">Analizador de contraseñas</string>
    <string name="tool_password_strength_analyser_desc">Descubre la robustez de tu contraseña y el tiempo estimado para romperla, sin salir del dispositivo.</string>
    <string name="tool_pdf_signature_checker">Verificador de firmas PDF</string>
    <string name="tool_pdf_signature_checker_desc">Verifica las firmas de un PDF para saber si su contenido ha sido alterado.</string>
